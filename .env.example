# Copy this file to .env and fill in your real Neon connection string.
# NEVER commit the real .env file.
# Get this from Neon Console -> your project -> Connection Details
# (use the pooled connection string, format: postgresql://user:password@host/db?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require
